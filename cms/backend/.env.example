# Copy this file to .env and fill in real values before running the server.

# Postgres connection string. If using the provided docker-compose.yml,
# this matches the service defaults below.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"

# Long, random string used to sign admin session JWTs.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change_this_to_a_long_random_string"

# Credentials for the ONE admin account, used only by the seed script.
# Change the password before seeding, and change it again afterwards
# is not possible from here - use the admin dashboard's "change password"
# screen or re-run the seed after editing this file.
ADMIN_USERNAME="junior"
ADMIN_PASSWORD="change_this_password_before_seeding"

# Must match where the frontend is served from - used for CORS + cookies.
FRONTEND_URL="http://localhost:5173"

PORT=4000
NODE_ENV=development
